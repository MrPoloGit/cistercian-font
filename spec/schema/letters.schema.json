{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cistercian letter mapping spec",
  "type": "object",
  "required": ["mapping_mode", "letters"],
  "additionalProperties": false,
  "properties": {
    "mapping_mode": { "type": "string", "enum": ["shared", "extended"] },
    "letters": {
      "type": "object",
      "minProperties": 26,
      "maxProperties": 26,
      "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 26 },
      "propertyNames": { "pattern": "^[A-Z]$" }
    }
  }
}
